{
  "name": "@lsfcy/dsh-composer-predictions",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "description": "Codex-style composer predictions for DeepSeek Harness: after a turn settles, the empty composer shows a dimmed suggestion of your next message; Tab accepts it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "composer",
    "prediction",
    "suggestion"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "build.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/unit.test.mjs test/bundle.test.mjs test/http.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsfcy/dsh-composer-predictions.git"
  },
  "homepage": "https://github.com/lsfcy/dsh-composer-predictions#readme",
  "bugs": {
    "url": "https://github.com/lsfcy/dsh-composer-predictions/issues"
  }
}
